generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentStatus {
  ACTIVE
  INACTIVE
  NEEDS_REVIEW
}

enum TemplateStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  CLEAR
  PERFECT_CLEAR
  EXPIRED
  ABANDONED
}

enum SessionCellStatus {
  LOCKED
  AVAILABLE
  SUBMITTED
  VERIFIED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum VerificationType {
  GPS
  QR
  QUIZ
  PHOTO
  COMPOSITE
  ADMIN
}

enum MissionKind {
  PLACE_VISIT
  WALK_STEPS
  WALK_DISTANCE
  QUIZ
  QR_SCAN
  PHOTO
  CHECK_IN
  COMPOSITE
}

enum MissionScope {
  COMMON
  REGION
  EVENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ENDED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id               String                 @id @default(uuid()) @db.Uuid
  role             UserRole               @default(USER)
  nickname         String                 @db.VarChar(40)
  email            String?                @unique @db.VarChar(254)
  passwordHash     String?                @db.VarChar(255)
  status           UserStatus             @default(ACTIVE)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  ownedTemplates   BingoTemplate[]        @relation("TemplateOwner")
  bingoSessions    BingoSession[]
  verifications    Verification[]
  pointLedger      PointLedger[]
  authSessions     AuthSession[]
  missionRevisions MissionRevision[]      @relation("MissionRevisionAuthor")
  dailyRankings    DailyRankingSnapshot[]
  announcementReads AnnouncementRead[]
  sentFriendships    Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
  blocksCreated       UserBlock[]  @relation("UserBlockCreator")
  blocksReceived      UserBlock[]  @relation("UserBlockTarget")
  reportsCreated      UserReport[] @relation("UserReportCreator")
  reportsReceived     UserReport[] @relation("UserReportTarget")

  @@index([status, createdAt])
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  requesterSeenAcceptedAt DateTime?      @db.Timestamptz(3)
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("UserBlockCreator", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @db.Uuid
  reportedId String           @db.Uuid
  reason     String           @db.VarChar(40)
  detail     String?          @db.VarChar(500)
  status     UserReportStatus @default(OPEN)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?        @db.Timestamptz(3)
  reporter   User             @relation("UserReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User             @relation("UserReportTarget", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reportedId, status])
}

model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  title       String             @db.VarChar(160)
  content     String
  status      AnnouncementStatus @default(DRAFT)
  isImportant Boolean            @default(false)
  startsAt    DateTime?          @db.Timestamptz(3)
  endsAt      DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  reads       AnnouncementRead[]

  @@index([status, startsAt, endsAt])
  @@index([isImportant, createdAt])
}

model AnnouncementRead {
  announcementId String       @db.Uuid
  userId         String       @db.Uuid
  readAt         DateTime     @default(now()) @db.Timestamptz(3)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId, readAt])
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Region {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String              @db.VarChar(80)
  administrativeCode    String              @unique @db.VarChar(20)
  centerLatitude        Decimal             @db.Decimal(9, 6)
  centerLongitude       Decimal             @db.Decimal(9, 6)
  populationDeclineFlag Boolean             @default(false)
  status                ContentStatus       @default(ACTIVE)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  places                Place[]
  themes                BingoTheme[]
  templates             BingoTemplate[]
  missionLinks          MissionRegion[]
  missionCollections    MissionCollection[]

  @@index([status, populationDeclineFlag])
}

model Place {
  id                String                               @id @default(uuid()) @db.Uuid
  regionId          String                               @db.Uuid
  source            String                               @db.VarChar(30)
  externalContentId String                               @db.VarChar(100)
  contentType       String                               @db.VarChar(40)
  title             String                               @db.VarChar(200)
  address           String?
  latitude          Decimal                              @db.Decimal(9, 6)
  longitude         Decimal                              @db.Decimal(9, 6)
  location          Unsupported("geometry(Point,4326)")?
  imageUrl          String?
  status            ContentStatus                        @default(ACTIVE)
  sourceUpdatedAt   DateTime?                            @db.Timestamptz(3)
  syncedAt          DateTime                             @default(now()) @db.Timestamptz(3)
  createdAt         DateTime                             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                             @updatedAt @db.Timestamptz(3)
  region            Region                               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  missions          Mission[]

  @@unique([source, externalContentId, contentType])
  @@index([regionId, contentType, status])
}

model BingoTheme {
  id                            String          @id @default(uuid()) @db.Uuid
  regionId                      String          @db.Uuid
  name                          String          @db.VarChar(80)
  category                      String          @db.VarChar(40)
  isRequiredForRegionCompletion Boolean         @default(false)
  status                        ContentStatus   @default(ACTIVE)
  displayOrder                  Int             @default(0)
  createdAt                     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime        @updatedAt @db.Timestamptz(3)
  region                        Region          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  templates                     BingoTemplate[]

  @@unique([regionId, name])
  @@index([regionId, status, displayOrder])
}

model BingoTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  regionId    String         @db.Uuid
  themeId     String         @db.Uuid
  ownerId     String?        @db.Uuid
  title       String         @db.VarChar(120)
  type        String         @db.VarChar(30)
  status      TemplateStatus @default(DRAFT)
  version     Int            @default(1)
  startsAt    DateTime?      @db.Timestamptz(3)
  endsAt      DateTime?      @db.Timestamptz(3)
  publishedAt DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  region      Region         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  theme       BingoTheme     @relation(fields: [themeId], references: [id], onDelete: Restrict)
  owner       User?          @relation("TemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  cells       TemplateCell[]
  sessions    BingoSession[]

  @@unique([themeId, version])
  @@index([regionId, status, startsAt, endsAt])
}

model Mission {
  id                  String                  @id @default(uuid()) @db.Uuid
  placeId             String?                 @db.Uuid
  kind                MissionKind
  scope               MissionScope            @default(COMMON)
  title               String                  @db.VarChar(120)
  description         String
  category            String                  @db.VarChar(40)
  verificationPolicy  Json
  targetValue         Decimal?                @db.Decimal(12, 2)
  targetUnit          String?                 @db.VarChar(30)
  radiusM             Int?
  points              Int
  difficulty          Int                     @default(1)
  estimatedMinutesMin Int?
  estimatedMinutesMax Int?
  similarityGroup     String?                 @db.VarChar(60)
  status              ContentStatus           @default(ACTIVE)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  place               Place?                  @relation(fields: [placeId], references: [id], onDelete: Restrict)
  templateCells       TemplateCell[]
  regionLinks         MissionRegion[]
  collectionItems     MissionCollectionItem[]
  revisions           MissionRevision[]

  @@index([placeId, status])
  @@index([category, status])
  @@index([scope, status, category])
  @@index([similarityGroup, status])
}

model MissionRegion {
  missionId String   @db.Uuid
  regionId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([missionId, regionId])
  @@index([regionId, missionId])
}

model MissionCollection {
  id          String                  @id @default(uuid()) @db.Uuid
  regionId    String?                 @db.Uuid
  name        String                  @db.VarChar(120)
  type        String                  @db.VarChar(30)
  description String?
  status      ContentStatus           @default(ACTIVE)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  region      Region?                 @relation(fields: [regionId], references: [id], onDelete: Restrict)
  items       MissionCollectionItem[]

  @@unique([type, regionId, name])
  @@index([type, regionId, status])
}

model MissionCollectionItem {
  collectionId String            @db.Uuid
  missionId    String            @db.Uuid
  displayOrder Int               @default(0)
  weight       Int               @default(100)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  collection   MissionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mission      Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([collectionId, missionId])
  @@index([collectionId, displayOrder])
  @@index([missionId])
}

model MissionRevision {
  id          String   @id @default(uuid()) @db.Uuid
  missionId   String   @db.Uuid
  revision    Int
  snapshot    Json
  changeNote  String?  @db.VarChar(300)
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  changedBy   User?    @relation("MissionRevisionAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([missionId, revision])
  @@index([missionId, createdAt])
}

model TemplateCell {
  id         String        @id @default(uuid()) @db.Uuid
  templateId String        @db.Uuid
  missionId  String        @db.Uuid
  position   Int
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  template   BingoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  mission    Mission       @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@unique([templateId, position])
  @@unique([templateId, missionId])
}

model BingoSession {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  templateId     String            @db.Uuid
  idempotencyKey String            @db.VarChar(100)
  dailyDate      DateTime?         @db.Date
  layoutVariant  Int?
  status         SessionStatus     @default(ACTIVE)
  version        Int               @default(1)
  totalPoints    Int               @default(0)
  startedAt      DateTime          @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  template       BingoTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  cells          SessionCell[]
  lineRewards    BingoLineReward[]
  pointLedger    PointLedger[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, templateId, dailyDate])
  @@index([userId, status, updatedAt])
}

model SessionCell {
  id              String            @id @default(uuid()) @db.Uuid
  sessionId       String            @db.Uuid
  position        Int
  missionSnapshot Json
  status          SessionCellStatus @default(AVAILABLE)
  verifiedAt      DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  session         BingoSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  verifications   Verification[]

  @@unique([sessionId, position])
  @@index([sessionId, status])
}

model Verification {
  id             String             @id @default(uuid()) @db.Uuid
  sessionCellId  String             @db.Uuid
  userId         String             @db.Uuid
  idempotencyKey String             @db.VarChar(100)
  type           VerificationType
  status         VerificationStatus @default(PENDING)
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  accuracyM      Decimal?           @db.Decimal(8, 2)
  measuredAt     DateTime?          @db.Timestamptz(3)
  distanceM      Decimal?           @db.Decimal(10, 2)
  photoKey       String?
  observedValue  Decimal?           @db.Decimal(12, 2)
  evidence       Json?
  reasonCode     String?            @db.VarChar(60)
  reasonDetail   String?
  submittedAt    DateTime           @default(now()) @db.Timestamptz(3)
  decidedAt      DateTime?          @db.Timestamptz(3)
  sessionCell    SessionCell        @relation(fields: [sessionCellId], references: [id], onDelete: Restrict)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([sessionCellId, status, submittedAt])
  @@index([status, submittedAt])
}

model BingoLineReward {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @db.Uuid
  lineKey   String       @db.VarChar(30)
  points    Int
  awardedAt DateTime     @default(now()) @db.Timestamptz(3)
  session   BingoSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, lineKey])
}

model PointLedger {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  sessionId     String?       @db.Uuid
  referenceType String        @db.VarChar(40)
  referenceId   String        @db.VarChar(100)
  reason        String        @db.VarChar(40)
  points        Int
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  session       BingoSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([referenceType, referenceId, reason])
  @@index([userId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String    @db.VarChar(100)
  aggregateId String    @db.VarChar(100)
  payload     Json
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, occurredAt])
}

model DailyOperation {
  id                String    @id @default(uuid()) @db.Uuid
  cycleDate         DateTime  @unique @db.Date
  status            String    @default("PROCESSING") @db.VarChar(20)
  templateId        String?   @db.Uuid
  rankingEntryCount Int       @default(0)
  rewardPointTotal  Int       @default(0)
  startedAt         DateTime  @default(now()) @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  lastError         String?

  @@index([status, cycleDate])
}

model DailyRankingSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  cycleDate    DateTime @db.Date
  userId       String   @db.Uuid
  rank         Int
  score        Int
  rewardPoints Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([cycleDate, userId])
  @@index([cycleDate, rank])
  @@index([userId, cycleDate])
}
