# Runtime
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# Database and cache
DATABASE_URL=postgresql://travel_bingo:travel_bingo@localhost:55432/travel_bingo
REDIS_URL=redis://localhost:56379

# Object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:59000
OBJECT_STORAGE_REGION=ap-northeast-2
OBJECT_STORAGE_BUCKET=travel-bingo-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# External providers
KTO_API_KEY=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
MAP_PROVIDER=
MAP_CLIENT_KEY=
